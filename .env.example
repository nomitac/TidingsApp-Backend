# Shared key the iOS app sends in the X-App-Key header.
APP_KEY=change-me

# Supabase (Project Settings -> API). The service-role key is SERVER ONLY.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Tables are public.tidings_* so this can share a Supabase project with another app. Defaults are fine.
SUPABASE_SCHEMA=public
SUPABASE_TABLE_PREFIX=tidings_

# memory | supabase. Defaults to memory when SUPABASE_URL is empty.
STORAGE_BACKEND=

# Public base URL used for wishlist share links and OG tags.
PUBLIC_BASE_URL=http://localhost:8000

# Invite codes expire after this many days.
INVITE_TTL_DAYS=14

# APNs token-based auth (optional; push is a no-op when unset).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.tidings.app
# Contents of the .p8 key; newlines may be written as \n.
APNS_PRIVATE_KEY=
APNS_USE_SANDBOX=true
